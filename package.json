{
  "name": "botcircuits-motion-video",
  "private": true,
  "version": "1.0.0",
  "description": "BotCircuits.ai industry hero animations (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render:travel:mp4": "remotion render TravelHero out/travel-hero-card.mp4 --codec=h264 --crf=16 --props='{\"background\":\"#808080\"}'",
    "render:travel:webm": "remotion render TravelHero out/travel-hero-card.webm --codec=vp9 --image-format=png --pixel-format=yuva420p",
    "render:travel:prores": "remotion render TravelHero out/travel-hero-card.mov --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le",
    "typecheck": "tsc --noEmit",
    "render:healthcare:mp4": "remotion render HealthcareHero out/healthcare-hero.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "render:healthcare:webm": "remotion render HealthcareHeroCard out/healthcare-hero-card.webm --codec=vp9 --image-format=png --pixel-format=yuva420p",
    "render:healthcare:poster": "remotion still HealthcareHero out/healthcare-hero-poster.png --frame=45"
  },
  "dependencies": {
    "@fontsource/host-grotesk": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.547",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
